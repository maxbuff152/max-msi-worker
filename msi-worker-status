#!/usr/bin/env bash
# Show MSI worker-dir map. Does not restart a live worker.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Prefer machine helper; fall back to repo / this script's directory
# shellcheck source=/dev/null
if [[ -f "$HOME/bin/msi-worker-dirs.sh" ]]; then
  source "$HOME/bin/msi-worker-dirs.sh"
elif [[ -f "$ROOT/msi-worker-dirs.sh" ]]; then
  source "$ROOT/msi-worker-dirs.sh"
else
  source "$(dirname "$0")/msi-worker-dirs.sh"
fi

echo "=== MSI worker-dir map (kept in place) ==="
printf '%s\n' "${MSI_WORKER_DIRS[@]}"
echo
echo "Existing dirs → flags:"
msi_worker_dir_flags
echo
echo "Controlled test:"
echo "  bash $HOME/Projects/active/max-msi-worker/msi-controlled-test.sh before"
echo "Restart Max-MSI later (when no agent is mid-run):"
echo "  bash $HOME/Projects/active/max-msi-worker/start-max-msi.sh"
