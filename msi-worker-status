#!/usr/bin/env bash
# Show MSI worker-dir map. Does not restart a live worker.
set -euo pipefail
# shellcheck source=/dev/null
source "$HOME/bin/msi-worker-dirs.sh"

echo "=== MSI worker-dir map ==="
msi_worker_list
echo
echo "Flags:"
msi_worker_dir_flags
echo
if pgrep -af 'agent.*worker start.*Max-MSI' >/dev/null 2>&1; then
  echo "Live Max-MSI process:"
  pgrep -af 'agent.*worker start.*Max-MSI' || true
else
  echo "Live Max-MSI process: (none)"
fi
echo
echo "Soft-restart (applies canonical dirs; drops in-flight Max-MSI agents):"
echo "  bash $HOME/Projects/active/max-msi-worker/start-max-msi.sh --restart"
