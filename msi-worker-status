#!/usr/bin/env bash
# Show MSI worker-dir map and whether Max-MSI is actually running.
set -euo pipefail
# shellcheck source=/dev/null
source "$HOME/bin/msi-worker-dirs.sh" 2>/dev/null || source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/msi-worker-dirs.sh"

echo "=== MSI phone label ==="
msi_worker_list
echo
echo "=== flags ==="
msi_worker_dir_flags
echo
echo "=== tmux ==="
tmux list-sessions 2>/dev/null | grep -E 'msi-workers|max-msi-worker' || echo '(no max-msi-worker session)'
echo
echo "=== agent processes ==="
pgrep -af 'worker start --name (Max-MSI|MSI)' || echo '(none)'
echo
echo "Restart: bash $HOME/Projects/active/max-msi-worker/start-max-msi.sh --restart"
